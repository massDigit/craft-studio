# ==============================================================================
# ZEN TOO Craft — Variables d'Environnement de Production
# ==============================================================================
# Copier ce fichier sous le nom .env.local sur le VPS (/home/project/craft-studio)
# et renseigner des secrets réels et uniques. NE JAMAIS COMMITTER LE FICHIER RÉEL.
# ==============================================================================

# Application Symfony
APP_ENV=prod
APP_DEBUG=0
# Générer avec : openssl rand -hex 32
APP_SECRET=changer_ce_secret_aleatoire_32_caracteres_min

# Base de Données MySQL (Interne au réseau Docker ztc_internal)
MYSQL_ROOT_PASSWORD=changer_ce_mot_de_passe_root_robuste
MYSQL_USER=sylius
MYSQL_PASSWORD=changer_ce_mot_de_passe_sylius_robuste
MYSQL_DATABASE=sylius_prod

# Messagerie Transactionnelle (Brevo SMTP Relay)
# Format : smtp://LOGIN_BREVO:CLE_API_SMTP@smtp-relay.brevo.com:587
MAILER_DSN=smtp://contact@zentoo-craft.fr:cle_smtp_brevo@smtp-relay.brevo.com:587

# Authentification API & JWT
# Générer avec : openssl rand -hex 16
JWT_PASSPHRASE=changer_cette_passphrase_jwt

# Configuration Générale
PHP_DATE_TIMEZONE=Europe/Paris
DEFAULT_URI=https://zentoo-craft.fr
