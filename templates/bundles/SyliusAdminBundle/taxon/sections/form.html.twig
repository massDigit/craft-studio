{% form_theme form '@SyliusAdmin/taxon/form_theme.html.twig' '@SyliusAdmin/taxon/sections/form_faq_theme.html.twig' %}

<div {{ attributes }}>
    {{ form_start(form, {'attr': {'class': 'ui loadable form', 'novalidate': 'novalidate', 'id': form.vars.id}}) }}
    {% if hookable_metadata.configuration.method is defined %}
        <input type="hidden" name="_method" value="{{ hookable_metadata.configuration.method }}" />
    {% endif %}
    {{ form_errors(form) }}

    {% hook 'form' with { form } %}

    <!-- FAQ BLOCK -->
    <div class="card mb-3" style="border-left: 4px solid #D4AF37;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="card-title">Foire Aux Questions</h2>
        </div>
        <div class="card-body bg-light">
            <p class="text-muted small mb-4">Questions et réponses qui apparaîtront sur la boutique pour ce catalogue.</p>
            
            <div id="faq-items-container" data-prototype="{{ form_widget(form.faqItems.vars.prototype)|e('html_attr') }}">
                {% for faqItem in form.faqItems %}
                    {{ form_widget(faqItem) }}
                {% endfor %}
            </div>

            <button type="button" class="btn btn-outline-success mt-3" id="add-faq-btn">
                + Ajouter une question
            </button>
        </div>
    </div>

    {{ form_end(form, {render_rest: hookable.configuration.render_rest|default(false)}) }}

    <style>
        .btn-ai-generate {
            background: linear-gradient(135deg, #6f42c1, #8A2BE2);
            color: white;
            border: none;
            font-size: 0.85rem;
            font-weight: 500;
            padding: 0.4rem 0.75rem;
            border-radius: 0.25rem;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 15px;
            cursor: pointer;
        }
        .btn-ai-generate:hover {
            background: linear-gradient(135deg, #59339d, #6b21b0);
            color: white;
            transform: translateY(-1px);
        }
        .btn-ai-translate {
            background: linear-gradient(135deg, #0d6efd, #0dcaf0);
            color: white;
            border: none;
            font-size: 0.85rem;
            font-weight: 500;
            padding: 0.4rem 0.75rem;
            border-radius: 0.25rem;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
        }
        .btn-ai-translate:hover {
            background: linear-gradient(135deg, #0b5ed7, #0bacce);
            color: white;
            transform: translateY(-1px);
        }
        .ai-loading {
            display: none;
            font-size: 0.85rem;
            color: #6f42c1;
            font-weight: 500;
            margin-bottom: 15px;
        }
        .ai-loading.active {
            display: inline-block;
        }
    </style>

    <script>
        (function() {
            if (window._ztcFaqInitialized) {
                return;
            }
            window._ztcFaqInitialized = true;

            document.addEventListener('click', function(e) {
                // 1. Bouton Ajouter une FAQ (supporte les re-renders du Live Component)
                const addBtn = e.target.closest('#add-faq-btn');
                if (addBtn) {
                    e.preventDefault();
                    const container = document.getElementById('faq-items-container');
                    if (!container) return;
                    const index = container.querySelectorAll('[data-form-collection-item]').length;
                    const prototype = container.dataset.prototype;
                    if (!prototype) return;

                    // Calculer la prochaine position maximale
                    let maxPos = -1;
                    container.querySelectorAll('.faq-input-position').forEach(input => {
                        const val = parseInt(input.value, 10);
                        if (!isNaN(val) && val > maxPos) {
                            maxPos = val;
                        }
                    });
                    const nextPos = maxPos + 1;

                    const newForm = prototype.replace(/__name__/g, index);
                    const div = document.createElement('div');
                    div.innerHTML = newForm;
                    const newItem = div.firstElementChild || div;
                    
                    const newPosInput = newItem.querySelector('.faq-input-position');
                    if (newPosInput) {
                        newPosInput.value = nextPos;
                    }

                    container.appendChild(newItem);
                    return;
                }

                // 2. Bouton Générer FAQ par IA
                const genBtn = e.target.closest('.btn-ai-generate');
                if (genBtn) {
                    e.preventDefault();
                    const container = genBtn.closest('[data-form-collection-item]');
                    if (!container) return;
                    
                    const questionInput = container.querySelector('.faq-input-question');
                    const answerInput = container.querySelector('.faq-input-answer');
                    const loader = container.querySelector('.ai-loading');
                    
                    if (!questionInput || !answerInput) {
                        alert('Champs introuvables.');
                        return;
                    }

                    let taxonName = '';
                    const nameInputs = document.querySelectorAll('input[name*="[translations]"][name*="[name]"]');
                    if (nameInputs.length > 0) {
                        taxonName = nameInputs[0].value;
                    }
                    if (!taxonName) {
                        taxonName = 'Général';
                    }

                    let taxonDescription = '';
                    const descInputs = document.querySelectorAll('textarea[name*="[translations]"][name*="[description]"], input[name*="[translations]"][name*="[description]"]');
                    if (descInputs.length > 0) {
                        taxonDescription = descInputs[0].value || '';
                    }
                    
                    genBtn.style.display = 'none';
                    if (loader) loader.classList.add('active');
                    questionInput.disabled = true;
                    answerInput.disabled = true;

                    const showToast = function(message, type = 'success') {
                        let container = document.getElementById('ztc-toast-container');
                        if (!container) {
                            container = document.createElement('div');
                            container.id = 'ztc-toast-container';
                            container.style.position = 'fixed';
                            container.style.top = '1.5rem';
                            container.style.right = '1.5rem';
                            container.style.zIndex = '99999';
                            container.style.display = 'flex';
                            container.style.flexDirection = 'column';
                            container.style.gap = '0.5rem';
                            container.style.pointerEvents = 'none';
                            document.body.appendChild(container);
                        }

                        const toast = document.createElement('div');
                        toast.className = `alert alert-${type === 'success' ? 'success' : 'danger'} alert-dismissible shadow fade show mb-0`;
                        toast.style.pointerEvents = 'auto';
                        toast.style.minWidth = '300px';
                        toast.style.maxWidth = '420px';
                        toast.style.borderRadius = '8px';
                        toast.style.border = type === 'success' ? '1px solid #2fb344' : '1px solid #d63939';
                        toast.style.backgroundColor = type === 'success' ? '#edfbf0' : '#fdeded';
                        toast.style.color = '#1e293b';
                        toast.innerHTML = `
                            <div class="d-flex align-items-center">
                                <span class="fs-3 me-2">${type === 'success' ? '✨' : '⚠️'}</span>
                                <div>
                                    <strong class="d-block text-${type === 'success' ? 'success' : 'danger'}">${type === 'success' ? 'IA ZEN TOO' : 'Erreur IA'}</strong>
                                    <div class="small text-muted">${message}</div>
                                </div>
                                <button type="button" class="btn-close ms-auto" aria-label="Close"></button>
                            </div>
                        `;

                        toast.querySelector('.btn-close').addEventListener('click', () => {
                            toast.remove();
                        });

                        container.appendChild(toast);

                        setTimeout(() => {
                            toast.style.opacity = '0';
                            toast.style.transform = 'translateY(-10px)';
                            toast.style.transition = 'all 0.4s ease-out';
                            setTimeout(() => toast.remove(), 400);
                        }, 4000);
                    };

                    fetch('/admin/ajax/ai/generate-faq', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ taxonName: taxonName, taxonDescription: taxonDescription })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            questionInput.value = data.question;
                            answerInput.value = data.answer;
                            showToast('Question & réponse FAQ générées avec succès !', 'success');
                        } else {
                            showToast('Erreur IA : ' + data.error, 'danger');
                        }
                    })
                    .catch(error => {
                        console.error(error);
                        showToast('Erreur de communication avec le service IA.', 'danger');
                    })
                    .finally(() => {
                        if (loader) loader.classList.remove('active');
                        genBtn.style.display = 'inline-flex';
                        questionInput.disabled = false;
                        answerInput.disabled = false;
                    });
                    return;
                }

                // 3. Bouton Traduire la FAQ par IA
                const transBtn = e.target.closest('.btn-ai-translate');
                if (transBtn) {
                    e.preventDefault();
                    const container = transBtn.closest('[data-form-collection-item]');
                    if (!container) return;
                    
                    const qInputs = container.querySelectorAll('.faq-input-question');
                    const aInputs = container.querySelectorAll('.faq-input-answer');
                    
                    if (qInputs.length <= 1) {
                        alert("Votre boutique ne semble avoir qu'une seule langue configurée.");
                        return;
                    }

                    let sourceIndex = -1;
                    for (let i = 0; i < qInputs.length; i++) {
                        if (qInputs[i].value.trim() !== '') {
                            sourceIndex = i;
                            break;
                        }
                    }

                    if (sourceIndex === -1) {
                        alert("Veuillez d'abord rédiger (ou générer) la question dans au moins une langue avant de traduire.");
                        return;
                    }

                    const sourceQ = qInputs[sourceIndex].value;
                    const sourceA = aInputs[sourceIndex].value;

                    const loader = container.querySelector('.ai-loading');
                    const generateBtn = container.querySelector('.btn-ai-generate');
                    
                    transBtn.style.display = 'none';
                    if (generateBtn) generateBtn.style.display = 'none';
                    if (loader) {
                        loader.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> L\'IA traduit votre FAQ dans les autres langues...';
                        loader.classList.add('active');
                    }

                    let promises = [];

                    qInputs.forEach((input, index) => {
                        if (index === sourceIndex) return;
                        
                        const match = input.name.match(/\[translations\]\[([^\]]+)\]/);
                        if (!match) return;
                        const targetLocale = match[1];

                        let p = fetch('/admin/ajax/ai/translate-document', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                fields: { q: sourceQ, a: sourceA },
                                targetLocale: targetLocale
                            })
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success && data.fields) {
                                qInputs[index].value = data.fields.q;
                                aInputs[index].value = data.fields.a;
                            }
                        });

                        promises.push(p);
                    });

                    Promise.all(promises).then(() => {
                        if (loader) loader.classList.remove('active');
                        if (generateBtn) generateBtn.style.display = 'inline-flex';
                        transBtn.style.display = 'inline-flex';
                        transBtn.innerText = "✅ Traductions terminées";
                        setTimeout(() => transBtn.innerText = "🌐 Traduire les autres langues", 3000);
                        
                        let showToastFn = window._ztcShowToast || function(msg) {
                            let c = document.getElementById('ztc-toast-container');
                            if (c) {
                                const t = document.createElement('div');
                                t.className = 'alert alert-success alert-dismissible shadow fade show mb-0';
                                t.innerHTML = '<div class="d-flex align-items-center"><span class="fs-3 me-2">✨</span><div><strong class="d-block text-success">IA ZEN TOO</strong><div class="small text-muted">' + msg + '</div></div></div>';
                                c.appendChild(t);
                                setTimeout(() => t.remove(), 4000);
                            }
                        };
                        showToastFn('FAQ bilingue synchronisée avec succès !');
                    }).catch(err => {
                        console.error(err);
                        alert("Une erreur de traduction s'est produite.");
                        if (loader) loader.classList.remove('active');
                        if (generateBtn) generateBtn.style.display = 'inline-flex';
                        transBtn.style.display = 'inline-flex';
                    });
                }
            });
        })();
    </script>
</div>
