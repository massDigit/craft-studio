<div class="container-xl" {{ attributes }}>
    {{ form_start(form, {'attr': {'class': 'ui loadable form', 'novalidate': 'novalidate', 'id': form.vars.id}}) }}
    {% if hookable_metadata.configuration.method is defined %}
        <input type="hidden" name="_method" value="{{ hookable_metadata.configuration.method }}" />
    {% endif %}
    {{ form_errors(form) }}
    {{ form_widget(form._token) }}

    <div class="row">
        <!-- Colonne Principale : Contenu du Document par Langue -->
        <div class="col-12 col-lg-8">
            <!-- Carte En-tete : Identite du Document -->
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold">
                    Identite Technique du Document Legal
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        {{ form_row(form.name, {'label': 'Nom Interne de la Page'}) }}
                        <div class="form-text text-muted">Nom de référence affiché dans l'administration (ex: Conditions Générales de Vente).</div>
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.code, {'label': 'Code Unique de Reference'}) }}
                        <div class="form-text text-muted">Identifiant unique technique (ex: cgv, mentions-legales).</div>
                    </div>
                </div>
            </div>

            <!-- Blocs de Redaction Isoles par Langue avec Badges Textiles Clairs -->
            {% for locale, translation in form.translations %}
                <div class="card mb-4 shadow-sm border border-secondary">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Redaction du Document Legal</span>
                        <span class="badge bg-warning text-dark fw-bold px-3 py-2" style="letter-spacing: 0.05em;">
                            Langue : {{ locale|upper }}
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            {{ form_row(translation.title, {'label': 'Titre du Document (' ~ locale|upper ~ ')'}) }}
                            <div class="form-text text-muted">Titre de la page visible par les clients (ex: Conditions Générales de Vente).</div>
                        </div>
                        <div class="mb-3">
                            {{ form_row(translation.slug, {'label': 'Slug / URL Publique (' ~ locale|upper ~ ')'}) }}
                            <div class="form-text text-muted">Adresse web d'accès à la page (ex: cgv, mentions-legales).</div>
                        </div>
                        <div class="mb-3">
                            {{ form_row(translation.metaDescription, {
                                'label': 'Contenu Juridique / Texte de la Page Légale (' ~ locale|upper ~ ')',
                                'attr': {
                                    'data-controller': 'wysiwyg',
                                    'rows': 12
                                }
                            }) }}
                            <div class="form-text text-muted">Rédigez les clauses juridiques de cette langue. Utilisez la barre d'outils WYSIWYG pour formater les articles.</div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Colonne Laterale : Emplacement & Publication -->
        <div class="col-12 col-lg-4">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold">
                    Parametres d'Affichage & Publication
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        {{ form_row(form.enabled, {'label': 'Activer et publier cette page sur le site'}) }}
                        <div class="form-text text-muted">Si coché, la page sera immédiatement accessible aux visiteurs.</div>
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.collections, {'label': 'Emplacement dans le site'}) }}
                        <div class="form-text text-muted">Sélectionnez "footer_menu" pour lier cette page dans le pied de page.</div>
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.channels, {'label': 'Canaux de Diffusion'}) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ form_end(form, {render_rest: false}) }}
</div>
