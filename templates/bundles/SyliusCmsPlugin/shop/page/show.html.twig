{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ page.title }} — ZEN TOO Craft{% endblock %}

{% block content %}
    <div class="container py-5 my-3" style="max-width: 900px;">
        <!-- Fil d'Ariane -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('sylius_shop_homepage') }}" style="color: var(--gold-light, #E5C158); text-decoration: none;">Accueil</a></li>
                <li class="breadcrumb-item active" style="color: var(--text-primary, #F4EFE6);">{{ page.title }}</li>
            </ol>
        </nav>

        <!-- Carte Éditoriale "Sombre Obsidienne & Or" -->
        <article class="p-4 p-md-5" style="background: rgba(10, 12, 11, 0.95); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: 24px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);">
            <header class="text-center mb-5 pb-4 border-bottom" style="border-color: rgba(212, 175, 55, 0.2) !important;">
                <span class="ztc-badge-nature mb-3 d-inline-block">🍃 Page Éditoriale & Engagement</span>
                <h1 class="display-4 fw-bold mt-2" style="color: var(--text-primary, #F4EFE6); letter-spacing: 0.03em;">{{ page.title }}</h1>
            </header>

            <div class="ztc-cms-content" style="color: var(--text-secondary, #A0A8A2); line-height: 1.8; font-size: 1.1rem;">
                {% if page.contentElements is not empty %}
                    {% for contentElement in page.contentElements %}
                        <div class="mb-4">
                            {{ contentElement.content|raw }}
                        </div>
                    {% endfor %}
                {% else %}
                    <p>{{ page.metaDescription|default(page.title) }}</p>
                {% endif %}
            </div>

            <footer class="mt-5 pt-4 border-top text-center" style="border-color: rgba(212, 175, 55, 0.15) !important;">
                <a href="{{ path('sylius_shop_contact_request') }}" class="btn btn-lg px-4 py-3 fw-bold text-dark" style="background: linear-gradient(135deg, #D4AF37, #E5C158); border: none; border-radius: 30px; box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);">
                    ✉️ Échanger avec l'Artisan pour un Projet Sur-Mesure
                </a>
            </footer>
        </article>
    </div>
{% endblock %}
