{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ product.name }} — ZEN TOO Craft{% endblock %}

{% block content %}
    <div class="container py-4 my-3">
        <!-- Fil d'Ariane -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('sylius_shop_homepage') }}" style="color: var(--gold-light, #E5C158); text-decoration: none;">Accueil</a></li>
                {% if product.mainTaxon is not null %}
                    <li class="breadcrumb-item active" style="color: var(--text-muted, #656E68);">{{ product.mainTaxon.name }}</li>
                {% endif %}
                <li class="breadcrumb-item active" style="color: var(--text-primary, #F4EFE6);">{{ product.name }}</li>
            </ol>
        </nav>

        <div class="row g-5">
            <!-- Galerie d'Images Produit -->
            <div class="col-lg-6">
                <div class="p-3" style="background: rgba(19, 24, 21, 0.9); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: 20px;">
                    {% if product.images is not empty %}
                        <div class="position-relative overflow-hidden" style="border-radius: 14px; background: #0a0c0b; min-height: 400px; display: flex; align-items: center; justify-content: center;">
                            <img src="{{ asset('media/image/' ~ product.images.first.path) }}" class="img-fluid w-100" style="object-fit: cover; max-height: 520px; border-radius: 12px;" alt="{{ product.name }}">
                            <span class="position-absolute top-0 end-0 m-3 badge" style="background: rgba(13, 15, 14, 0.9); color: #D4AF37; border: 1px solid rgba(212, 175, 55, 0.4); border-radius: 20px; padding: 0.5rem 1rem; letter-spacing: 0.05em;">
                                Bambou Naturel Ciselé
                            </span>
                        </div>
                    {% else %}
                        <div class="text-center py-5" style="background: #0a0c0b; border-radius: 14px;">
                            <div class="mt-3 text-muted">Visuel en cours de préparation</div>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Détails de la Création & Lecteur Audio -->
            <div class="col-lg-6 d-flex flex-column justify-content-between">
                <div>
                    <span class="text-uppercase fw-semibold" style="color: var(--gold-accent, #D4AF37); font-size: 0.85rem; letter-spacing: 0.1em;">
                        {{ product.mainTaxon.name|default('Création Artisanale') }}
                    </span>
                    <h1 class="display-5 fw-bold my-2" style="color: var(--text-primary, #F4EFE6);">
                        {{ product.name }}
                    </h1>
                    
                    <!-- Tarif Indicatif / Statut Pièce Unique -->
                    {% set variant = product.variants.first %}
                    {% if variant is not null and variant.channelPricings is not empty %}
                        <div class="my-3 d-flex align-items-center gap-3">
                            <span class="display-6 fw-bold" style="color: var(--gold-light, #E5C158);">
                                {{ (variant.channelPricings.first.price / 100)|number_format(2, ',', ' ') }} €
                            </span>
                            <span class="ztc-badge-unique">
                                <span class="ztc-badge-unique-dot"></span> Pièce Artisanale Unique
                            </span>
                        </div>
                    {% endif %}

                    <!-- Histoire & Conception -->
                    <div class="my-4 p-4" style="background: rgba(10, 12, 11, 0.8); border: 1px solid rgba(212, 175, 55, 0.15); border-radius: 14px;">
                        <h4 class="h6 text-uppercase fw-semibold mb-2" style="color: #D4AF37;">Histoire & Conception</h4>
                        <p style="color: var(--text-secondary, #A0A8A2); line-height: 1.7; margin-bottom: 0;">
                            {{ product.description|default('Création réalisée à la main dans l\'atelier ZEN TOO Craft à partir de tiges de bambou séchées naturellement au soleil.') }}
                        </p>
                    </div>

                    <!-- Lecteur Audio HTML5 Sur-Mesure -->
                    {% include 'shop/product/_audio_player.html.twig' with {'product': product} %}
                </div>

                <!-- Bouton d'Action Sur-Mesure (Redirection Contact Artisan) -->
                <div class="pt-4 border-top" style="border-color: rgba(212, 175, 55, 0.15) !important;">
                    <div class="d-grid gap-2">
                        <a href="{{ path('sylius_shop_contact_request') }}" class="btn btn-lg py-3 fw-bold text-dark text-center text-decoration-none" style="background: linear-gradient(135deg, #D4AF37, #E5C158); border: none; border-radius: 30px; box-shadow: 0 4px 20px rgba(212, 175, 55, 0.3);">
                            Échanger avec l'Artisan pour un Projet Sur-Mesure
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
