{% extends '@SyliusShop/shared/layout/base.html.twig' %}
{% import "@SyliusShop/shared/macro/money.html.twig" as money %}

{% block content %}
<div class="ztc-nav-container">
    <div style="max-width: 1400px; margin: 0 auto; width: 100%; padding-bottom: 8rem;">

        {% set current_taxon = ztc_current_taxon() %}
        {% set parent_taxon = (current_taxon and current_taxon.parent and current_taxon.parent.code != 'category') ? current_taxon.parent : current_taxon %}
        {% set sub_taxons = parent_taxon ? ztc_get_subtaxons_with_products(parent_taxon) : [] %}
        
        <!-- Taxon Hero Cinematic (Option B) -->
        <section class="ztc-taxon-hero">
            {% if current_taxon and current_taxon.images|length > 0 %}
                <img src="{{ asset('media/image/' ~ current_taxon.images.first.path) }}" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.75) contrast(1.05); z-index: 0;" alt="{{ current_taxon.name }}">
            {% else %}
                <img src="https://images.unsplash.com/photo-1520529986992-d4ce365fbc99?q=80&w=2000&auto=format&fit=crop" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.75) contrast(1.05); z-index: 0;" alt="Taxon Background">
            {% endif %}
            <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(5,6,5,1), rgba(8,10,9,0.4), transparent); z-index: 1;"></div>
            
            <div style="position: relative; z-index: 2; max-width: 48rem;">
                <span class="ztc-tag-gold" style="margin-bottom: 1rem; display: inline-block;">Collection Artisanale</span>
                <h1 style="font-family: 'Outfit', sans-serif; font-size: 3rem; font-weight: 300; margin-bottom: 1rem; color: #fff;">
                    {% if current_taxon %}
                        {{ current_taxon.name }}
                    {% else %}
                        Notre Collection
                    {% endif %}.
                </h1>
                <p style="font-size: 1.125rem; color: var(--text-secondary); line-height: 1.6; font-weight: 300;">
                    {% if current_taxon and current_taxon.description %}
                        {{ current_taxon.description }}
                    {% else %}
                        Des pièces uniques façonnées à la main à partir de bambous séchés naturellement. Chaque création possède sa propre voix et son propre caractère.
                    {% endif %}
                </p>
            </div>
        </section>

        <!-- Filters Minimalist Bar -->
        <div class="ztc-filter-bar">
            {% if sub_taxons|length > 0 %}
                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
                    <a href="{{ path('sylius_shop_product_index', {'slug': parent_taxon.slug, '_locale': sylius.localeCode}) }}" 
                       class="ztc-filter-pill {{ (not current_taxon or current_taxon.id == parent_taxon.id) ? 'active' : '' }}">
                        Toutes les créations
                    </a>
                    {% for sub_taxon in sub_taxons %}
                        <a href="{{ path('sylius_shop_product_index', {'slug': sub_taxon.slug, '_locale': sylius.localeCode}) }}" 
                           class="ztc-filter-pill {{ (current_taxon and current_taxon.id == sub_taxon.id) ? 'active' : '' }}">
                            {{ sub_taxon.name }}
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <div></div>
            {% endif %}
            <div style="font-size: 0.875rem; color: var(--text-secondary);">
                {{ resources.data|length }} création(s)
            </div>
        </div>

        <!-- Product Grid (Minimalist Option B) -->
        <div class="ztc-products-grid">
            {% for product in resources.data %}
                <a href="{{ path('sylius_shop_product_show', {'slug': product.slug, '_locale': sylius.localeCode}) }}" class="ztc-product-card-minimal" style="text-decoration: none; display: flex; flex-direction: column; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.04); border-radius: 24px; padding: 1rem; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); position: relative;">
                    <div class="visual" style="border-radius: 16px;">
                        {% if product.images|length > 0 %}
                            <img src="{{ product.images.first.path|imagine_filter('sylius_shop_product_thumbnail') }}" alt="{{ product.name }}">
                        {% else %}
                            <img src="https://images.unsplash.com/photo-1599839575945-a9e5af0c3fa5?q=80&w=800&auto=format&fit=crop" alt="Default">
                        {% endif %}
                        
                        {% if product.audios|length > 0 %}
                            {% set primary_audio = product.primaryAudio %}
                            <div class="ztc-audio-overlay" 
                                 data-audio-url="{{ asset('media/audio/' ~ primary_audio.path) }}"
                                 data-label="{{ primary_audio.label }}"
                                 title="Écouter : {{ primary_audio.label }}">
                                <div class="ztc-play-btn">
                                    {# Play icon #}
                                    <svg class="icon-play" width="12" height="14" viewBox="0 0 14 16" fill="currentColor"><path d="M0 0L14 8L0 16V0Z"/></svg>
                                    {# Pause icon #}
                                    <svg class="icon-pause" width="12" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><rect x="4" y="2" width="4" height="20"/><rect x="16" y="2" width="4" height="20"/></svg>
                                </div>
                                <div style="flex-grow: 1;">
                                    <div style="font-size: 10px; color: var(--gold-accent); text-transform: uppercase; letter-spacing: 0.1em; font-weight: bold; margin-bottom: 4px;">{{ primary_audio.label }}</div>
                                    <div style="height: 4px; width: 100%; background: rgba(255,255,255,0.1); border-radius: 9999px; overflow: hidden;">
                                        <div class="ztc-audio-progress" style="width: 0%; height: 100%; background: var(--gold-accent); transition: width 0.3s linear;"></div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
                        <h3 style="font-family: 'Outfit', sans-serif; font-size: 1.5rem; font-weight: 500; color: #fff; margin: 0;">{{ product.name }}</h3>
                        <span style="font-weight: 500; font-size: 1.125rem; color: var(--gold-accent);">
                            {% if not product.variants.empty %}
                                {{ money.calculatePrice(product.variants.first) }}
                            {% endif %}
                        </span>
                    </div>
                    <p style="color: var(--text-secondary); font-size: 0.875rem; margin: 0 0 1.5rem 0; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        {{ product.shortDescription|default('Finition naturelle.')|striptags }}
                    </p>
                    <div style="display: flex; width: 100%; margin-top: auto;">
                        <span class="ztc-cta-btn" style="display: flex; width: 100%; justify-content: center; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; border-radius: 9999px; font-size: 0.875rem; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; color: var(--gold-accent); background: rgba(212, 175, 55, 0.05); border: 1px solid rgba(212, 175, 55, 0.15); backdrop-filter: blur(10px); transition: all 0.4s ease;">
                            Découvrir
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.4s ease;"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </span>
                    </div>
                </a>
            {% else %}
                <div style="grid-column: 1 / -1; text-align: center; padding: 4rem; background: rgba(255,255,255,0.02); border-radius: 24px; color: var(--text-secondary);">
                    Aucune création disponible pour le moment.
                </div>
            {% endfor %}
        </div>

        {% if current_taxon and current_taxon.faqItems|length > 0 %}
            <section style="margin-top: 6rem; padding-top: 4rem; border-top: 1px solid rgba(255,255,255,0.05); max-width: 800px; margin-left: auto; margin-right: auto;">
                <h2 style="font-size: 2rem; font-weight: 400; color: var(--gold-accent); text-align: center; margin-bottom: 3rem;">Foire Aux Questions</h2>
                
                {% for faq in current_taxon.faqItems %}
                    <div class="faq-item" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                        <button class="faq-question" onclick="this.parentElement.classList.toggle('active')" style="width: 100%; background: none; border: none; color: var(--text-primary); font-size: 1.25rem; font-weight: 400; padding: 1.5rem 0; text-align: left; display: flex; justify-content: space-between; align-items: center; cursor: pointer;">
                            {{ faq.question }}
                            <span style="font-size: 1.5rem; color: var(--gold-accent);">+</span>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.4s ease-in-out;">
                            <div style="padding-bottom: 1.5rem; color: var(--text-secondary); line-height: 1.7;">
                                {{ faq.answer }}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </section>
        {% endif %}
        
    </div>
</div>

<style>
    .faq-item.active .faq-answer { max-height: 500px; }
    .faq-item.active .faq-question span { transform: rotate(45deg); display: inline-block; transition: transform 0.3s; }
    
    .ztc-product-card-minimal:hover {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    }
    
    .ztc-product-card-minimal:hover .ztc-cta-btn {
        background: var(--gold-accent) !important;
        color: #050605 !important;
        border-color: var(--gold-accent) !important;
    }

    .ztc-product-card-minimal:hover .ztc-cta-btn svg {
        transform: translateX(4px);
    }

    .ztc-play-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--gold-accent);
        color: #050605;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: transform 0.2s ease, background 0.2s ease;
    }

    .ztc-audio-overlay:hover .ztc-play-btn {
        transform: scale(1.1);
    }

    .ztc-audio-overlay.is-playing .ztc-play-btn {
        background: #fff;
    }

    .ztc-filter-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 1.25rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: var(--text-secondary);
        transition: all 0.3s ease;
    }

    .ztc-filter-pill:hover {
        color: var(--text-primary);
        border-color: rgba(212, 175, 55, 0.4);
        background: rgba(255, 255, 255, 0.06);
    }

    .ztc-filter-pill.active {
        background: rgba(212, 175, 55, 0.15);
        border-color: var(--gold-accent);
        color: var(--gold-accent);
        font-weight: 500;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    let currentAudio = null;
    let currentOverlay = null;

    document.querySelectorAll('.ztc-audio-overlay').forEach(function (overlay) {
        overlay.style.cursor = 'pointer';

        overlay.addEventListener('click', function (e) {
            // Stop navigation to the product page
            e.preventDefault();
            e.stopPropagation();

            const url = overlay.dataset.audioUrl;
            const progressBar = overlay.querySelector('.ztc-audio-progress');
            const iconPlay = overlay.querySelector('.icon-play');
            const iconPause = overlay.querySelector('.icon-pause');

            // If this overlay is already playing → pause it
            if (currentAudio && currentOverlay === overlay && !currentAudio.paused) {
                currentAudio.pause();
                iconPlay.style.display = '';
                iconPause.style.display = 'none';
                overlay.classList.remove('is-playing');
                return;
            }

            // Stop any other playing audio
            if (currentAudio && !currentAudio.paused) {
                currentAudio.pause();
                if (currentOverlay) {
                    currentOverlay.querySelector('.icon-play').style.display = '';
                    currentOverlay.querySelector('.icon-pause').style.display = 'none';
                    currentOverlay.querySelector('.ztc-audio-progress').style.width = '0%';
                    currentOverlay.classList.remove('is-playing');
                }
            }

            // If same overlay but was paused → resume
            if (currentAudio && currentOverlay === overlay) {
                currentAudio.play();
                iconPlay.style.display = 'none';
                iconPause.style.display = '';
                overlay.classList.add('is-playing');
                return;
            }

            // New audio
            const audio = new Audio(url);
            currentAudio = audio;
            currentOverlay = overlay;

            iconPlay.style.display = 'none';
            iconPause.style.display = '';
            overlay.classList.add('is-playing');

            audio.play().catch(function (err) {
                console.warn('Audio play failed:', err);
                iconPlay.style.display = '';
                iconPause.style.display = 'none';
                overlay.classList.remove('is-playing');
            });

            // Progress bar
            audio.addEventListener('timeupdate', function () {
                if (audio.duration) {
                    progressBar.style.width = (audio.currentTime / audio.duration * 100) + '%';
                }
            });

            // Reset on end
            audio.addEventListener('ended', function () {
                iconPlay.style.display = '';
                iconPause.style.display = 'none';
                progressBar.style.width = '0%';
                overlay.classList.remove('is-playing');
                currentAudio = null;
                currentOverlay = null;
            });
        });
    });
});
</script>
{% endblock %}
