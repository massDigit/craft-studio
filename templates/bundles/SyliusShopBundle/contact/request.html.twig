{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}Contacter l'Artisan — ZEN TOO Craft{% endblock %}

{% block content %}
    <div class="container py-5 my-3" style="max-width: 900px;">
        <div class="text-center mb-5">
            <span class="ztc-badge-nature mb-3">✉️ Échange & Projets Sur-Mesure</span>
            <h1 class="display-4 fw-bold mt-2" style="color: var(--text-primary, #F4EFE6);">Contacter l'Artisan</h1>
            <p class="lead mx-auto" style="color: var(--text-secondary, #A0A8A2); max-width: 600px;">
                Une question sur une création ? Une demande d'accordage spécifique (La 440 Hz / 432 Hz) ou un projet de luminaire sur-mesure ? Écrivez-nous.
            </p>
        </div>

        <div class="row g-5 align-items-stretch">
            <!-- Formulaire de Contact -->
            <div class="col-lg-7">
                <div class="p-4 p-md-5 h-100" style="background: rgba(19, 24, 21, 0.9); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: 20px;">
                    <form method="post" action="{{ path('sylius_shop_contact_request') }}" novalidate>
                        <div class="mb-3">
                            <label for="contact_email" class="form-label fw-semibold" style="color: #F4EFE6;">Adresse Email</label>
                            <input type="email" id="contact_email" name="sylius_contact[email]" class="form-control form-control-lg" style="background: #0a0c0b; border: 1px solid rgba(212, 175, 55, 0.2); color: #F4EFE6; border-radius: 10px;" placeholder="votre.email@exemple.fr" required>
                        </div>
                        <div class="mb-3">
                            <label for="contact_message" class="form-label fw-semibold" style="color: #F4EFE6;">Votre Message / Projet</label>
                            <textarea id="contact_message" name="sylius_contact[message]" rows="6" class="form-control form-control-lg" style="background: #0a0c0b; border: 1px solid rgba(212, 175, 55, 0.2); color: #F4EFE6; border-radius: 10px;" placeholder="Décrivez votre projet ou posez votre question à l'artisan..." required></textarea>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-lg py-3 fw-bold text-dark" style="background: linear-gradient(135deg, #D4AF37, #E5C158); border: none; border-radius: 30px; box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);">
                                📤 Envoyer à l'Artisan
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Carte Info Atelier -->
            <div class="col-lg-5">
                <div class="p-4 p-md-5 h-100 d-flex flex-column justify-content-between" style="background: rgba(10, 12, 11, 0.95); border: 1px solid rgba(212, 175, 55, 0.15); border-radius: 20px;">
                    <div>
                        <h3 class="h4 fw-bold mb-3" style="color: #E5C158;">Atelier ZEN TOO Craft</h3>
                        <p style="color: #A0A8A2; line-height: 1.7;">
                            Chaque pièce est façonnée individuellement avec passion et respect des matières naturelles.
                        </p>
                        <div class="mt-4 pt-3 border-top" style="border-color: rgba(212, 175, 55, 0.15) !important;">
                            <div class="d-flex align-items-center mb-3">
                                <span class="me-3 fs-4">🍃</span>
                                <div>
                                    <div class="fw-semibold" style="color: #F4EFE6;">Matériaux Éco-responsables</div>
                                    <div class="small" style="color: #A0A8A2;">Bambou naturel séché & Cire d'abeille bio</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center mb-3">
                                <span class="me-3 fs-4">🎼</span>
                                <div>
                                    <div class="fw-semibold" style="color: #F4EFE6;">Accordage de Précision</div>
                                    <div class="small" style="color: #A0A8A2;">La 440 Hz & 432 Hz selon vos souhaits</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
