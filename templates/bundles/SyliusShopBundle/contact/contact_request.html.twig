{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}Contacter l'artiste — ZEN TOO Craft{% endblock %}

{% block content %}
    <div class="container py-5 my-3" style="max-width: 720px;">
        <!-- Alertes & Messages Flash -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} mb-4" style="border-radius: 12px; background: {{ label == 'error' ? 'rgba(220, 53, 69, 0.15)' : 'rgba(40, 167, 69, 0.15)' }}; border: 1px solid {{ label == 'error' ? '#dc3545' : '#28a745' }}; color: #F4EFE6;">
                    {{ message|trans }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="text-center mb-5">
            <span class="ztc-badge-nature mb-3">✉️ Échange & Projets</span>
            <h1 class="display-4 fw-bold mt-2" style="color: var(--text-primary, #F4EFE6); font-family: 'Outfit', sans-serif;">Contacter l'artiste</h1>
            <p class="lead mx-auto" style="color: var(--text-secondary, #A0A8A2); max-width: 540px;">
                Une question sur une création ou un projet sur-mesure ? Écrivez-nous.
            </p>
        </div>

        <!-- Formulaire de Contact Centré -->
        <div class="p-4 p-md-5" style="background: rgba(19, 24, 21, 0.9); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: 24px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);">
            <form method="post" action="{{ path('sylius_shop_contact_request') }}" novalidate>
                {{ form_errors(form) }}
                {{ form_widget(form._token) }}

                <div class="mb-4">
                    <label for="contact_email" class="form-label fw-semibold" style="color: #F4EFE6;">Adresse Email</label>
                    <input type="email" id="contact_email" name="sylius_contact[email]" value="{{ form.email.vars.value|default('') }}" class="form-control form-control-lg ztc-input" style="background: #0a0c0b; border: 1px solid rgba(212, 175, 55, 0.2); color: #F4EFE6; border-radius: 12px; padding: 0.75rem 1rem;" placeholder="votre.email@exemple.fr" required>
                    {{ form_errors(form.email) }}
                </div>

                <div class="mb-4">
                    <label for="contact_message" class="form-label fw-semibold" style="color: #F4EFE6;">Votre Message</label>
                    <textarea id="contact_message" name="sylius_contact[message]" rows="6" class="form-control form-control-lg ztc-input" style="background: #0a0c0b; border: 1px solid rgba(212, 175, 55, 0.2); color: #F4EFE6; border-radius: 12px; padding: 0.75rem 1rem;" placeholder="Décrivez votre projet ou posez votre question à l'artiste..." required>{{ form.message.vars.value|default('') }}</textarea>
                    {{ form_errors(form.message) }}
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-lg py-3 fw-bold text-dark" style="background: linear-gradient(135deg, #D4AF37, #E5C158); border: none; border-radius: 30px; box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3); transition: all 0.3s ease;">
                        Envoyer le message
                    </button>
                </div>
            </form>
        </div>
    </div>

    <style>
        .ztc-input:focus {
            background: #0d100e !important;
            border-color: var(--gold-accent, #D4AF37) !important;
            box-shadow: 0 0 0 0.25rem rgba(212, 175, 55, 0.2) !important;
            color: #F4EFE6 !important;
        }
    </style>
{% endblock %}
