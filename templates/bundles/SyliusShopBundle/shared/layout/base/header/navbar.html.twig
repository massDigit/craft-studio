<nav class="ztc-navbar" id="ztcMainNav">
    <div class="ztc-nav-container">
        <!-- Logo de la Marque -->
        {{ include('@SyliusShop/shared/layout/base/header/content/logo.html.twig') }}

        {% set currentRoute = app.request.get('_route') %}
        {% set currentSlug = app.request.get('slug') %}
        {% set menuTaxon = sylius.channel.menuTaxon %}
        {% set taxonsToDisplay = (menuTaxon is not null and menuTaxon.children is not empty) ? menuTaxon.children : [] %}

        <!-- Navigation Desktop (>= 1200px) -->
        <div class="ztc-desktop-nav d-none d-xl-flex align-items-center">
            <ul class="ztc-nav-list navbar-nav list-unstyled d-flex flex-row align-items-center mb-0" style="list-style: none;">
                <li class="nav-item" style="list-style: none;">
                    <a class="ztc-nav-link {% if currentRoute == 'sylius_shop_homepage' %}active{% endif %}"
                       href="{{ path('sylius_shop_homepage') }}">
                        Accueil
                    </a>
                </li>

                {% for taxonItem in taxonsToDisplay %}
                    <li class="nav-item" style="list-style: none;">
                        <a class="ztc-nav-link {% if currentSlug == taxonItem.slug %}active{% endif %}"
                           href="{{ path('sylius_shop_product_index', {'slug': taxonItem.slug}) }}">
                            {{ ztc_short_taxon_name(taxonItem) }}
                        </a>
                    </li>
                {% endfor %}

                <li class="nav-item" style="list-style: none;">
                    <a class="ztc-nav-link {% if currentRoute starts with 'app_blog' %}active{% endif %}"
                       href="{{ path('app_blog_index') }}">
                        Journal
                    </a>
                </li>
            </ul>
        </div>

        <!-- Actions Droite : Bouton Sur-Mesure toujours visible + Bouton Burger (< 1200px) -->
        <div class="ztc-nav-actions d-flex align-items-center gap-2 gap-sm-3">
            <a class="ztc-btn-gold ztc-header-cta" href="{{ path('sylius_shop_contact_request') }}">
                Sur-Mesure
            </a>

            <!-- Bouton Burger Minimaliste avec Icône SVG Claire et Visible (< 1200px) -->
            <button class="ztc-burger-btn d-xl-none" type="button" data-bs-toggle="collapse" data-bs-target="#ztcMobileDrawer" aria-controls="ztcMobileDrawer" aria-expanded="false" aria-label="Menu principal">
                <!-- 3 barres quand fermé -->
                <svg class="ztc-burger-icon-bars" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                    <line x1="4" y1="6.5" x2="20" y2="6.5"></line>
                    <line x1="4" y1="12" x2="20" y2="12"></line>
                    <line x1="4" y1="17.5" x2="20" y2="17.5"></line>
                </svg>
                <!-- Croix quand ouvert -->
                <svg class="ztc-burger-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>

    <!-- Tiroir Mobile Épuré Dépoli (< 1200px) -->
    <div class="collapse ztc-mobile-drawer d-xl-none" id="ztcMobileDrawer">
        <div class="ztc-mobile-drawer-inner">
            <ul class="ztc-mobile-nav-list list-unstyled mb-0" style="list-style: none;">
                <li class="ztc-mobile-nav-item" style="list-style: none;">
                    <a class="ztc-mobile-nav-link {% if currentRoute == 'sylius_shop_homepage' %}active{% endif %}"
                       href="{{ path('sylius_shop_homepage') }}">
                        Accueil
                    </a>
                </li>

                {% for taxonItem in taxonsToDisplay %}
                    <li class="ztc-mobile-nav-item" style="list-style: none;">
                        <a class="ztc-mobile-nav-link {% if currentSlug == taxonItem.slug %}active{% endif %}"
                           href="{{ path('sylius_shop_product_index', {'slug': taxonItem.slug}) }}">
                            {{ ztc_short_taxon_name(taxonItem) }}
                        </a>
                    </li>
                {% endfor %}

                <li class="ztc-mobile-nav-item" style="list-style: none;">
                    <a class="ztc-mobile-nav-link {% if currentRoute starts with 'app_blog' %}active{% endif %}"
                       href="{{ path('app_blog_index') }}">
                        Journal
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<style id="ztc-navbar-critical-css">
/* Verrouillage immédiat des styles navbar pour cohérence avec la DA */
.ztc-navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: rgba(8, 10, 9, 0.88) !important;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
    padding: 1rem 0;
}

.ztc-nav-container {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
}

/* Bouton Burger Sobre et Épuré */
.ztc-burger-btn {
    background: transparent !important;
    border: none !important;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #F4EFE6 !important;
    transition: color 0.2s ease, background 0.2s ease;
    padding: 0;
    box-shadow: none !important;
}

.ztc-burger-btn:hover {
    background: rgba(255, 255, 255, 0.06) !important;
    color: var(--gold-accent, #D4AF37) !important;
}

.ztc-burger-btn .ztc-burger-icon-bars {
    display: block;
}

.ztc-burger-btn .ztc-burger-icon-close {
    display: none;
}

.ztc-burger-btn[aria-expanded="true"] {
    color: var(--gold-accent, #D4AF37) !important;
}

.ztc-burger-btn[aria-expanded="true"] .ztc-burger-icon-bars {
    display: none;
}

.ztc-burger-btn[aria-expanded="true"] .ztc-burger-icon-close {
    display: block;
}

/* Tiroir Mobile Épuré Dépoli */
.ztc-mobile-drawer {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    background: rgba(8, 10, 9, 0.96) !important;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7);
    max-height: calc(100vh - 75px);
    overflow-y: auto;
}

.ztc-mobile-drawer-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0.75rem 2rem 1.25rem;
}

.ztc-mobile-nav-list {
    list-style: none !important;
    list-style-type: none !important;
    margin: 0;
    padding: 0;
}

.ztc-mobile-nav-item {
    list-style: none !important;
    list-style-type: none !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.ztc-mobile-nav-item:last-child {
    border-bottom: none;
}

.ztc-mobile-nav-link {
    display: block;
    padding: 0.85rem 0.5rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--text-secondary, #B8B5AD) !important;
    text-decoration: none;
    transition: color 0.2s ease, padding-left 0.2s ease;
}

.ztc-mobile-nav-link:hover {
    color: var(--text-primary, #F4EFE6) !important;
    padding-left: 0.85rem;
}

.ztc-mobile-nav-link.active {
    color: var(--gold-accent, #D4AF37) !important;
    font-weight: 500;
}

@media (max-width: 576px) {
    .ztc-nav-container {
        padding: 0 1rem;
    }
    .ztc-mobile-drawer-inner {
        padding: 0.5rem 1rem 1rem;
    }
    .ztc-brand-logo {
        font-size: 0.92rem;
        letter-spacing: 0.14em;
    }
    .ztc-header-cta {
        padding: 0.42rem 0.85rem !important;
        font-size: 0.72rem !important;
    }
}
</style>
