<nav class="ztc-navbar" id="ztcMainNav">
    <div class="ztc-nav-container">
        <!-- Logo de la Marque -->
        {{ include('@SyliusShop/shared/layout/base/header/content/logo.html.twig') }}

        {% set currentRoute = app.request.get('_route') %}
        {% set currentSlug = app.request.get('slug') %}
        {% set menuTaxon = sylius.channel.menuTaxon %}
        {% set taxonsToDisplay = (menuTaxon is not null and menuTaxon.children is not empty) ? menuTaxon.children : [] %}

        <!-- Navigation Desktop (>= 1200px) -->
        <div class="ztc-desktop-nav d-none d-xl-flex align-items-center">
            <ul class="ztc-nav-list navbar-nav list-unstyled d-flex flex-row align-items-center mb-0" style="list-style: none;">
                <li class="nav-item" style="list-style: none;">
                    <a class="ztc-nav-link {% if currentRoute == 'sylius_shop_homepage' %}active{% endif %}"
                       href="{{ path('sylius_shop_homepage') }}">
                        Accueil
                    </a>
                </li>

                {% for taxonItem in taxonsToDisplay %}
                    <li class="nav-item" style="list-style: none;">
                        <a class="ztc-nav-link {% if currentSlug == taxonItem.slug %}active{% endif %}"
                           href="{{ path('sylius_shop_product_index', {'slug': taxonItem.slug}) }}">
                            {{ ztc_short_taxon_name(taxonItem) }}
                        </a>
                    </li>
                {% endfor %}

                <li class="nav-item" style="list-style: none;">
                    <a class="ztc-nav-link {% if currentRoute starts with 'app_blog' %}active{% endif %}"
                       href="{{ path('app_blog_index') }}">
                        Journal
                    </a>
                </li>
            </ul>
        </div>

        <!-- Actions Droite : Bouton Sur-Mesure toujours visible + Bouton Burger (< 1200px) -->
        <div class="ztc-nav-actions d-flex align-items-center gap-2 gap-sm-3">
            <a class="ztc-btn-gold ztc-header-cta" href="{{ path('sylius_shop_contact_request') }}">
                Sur-Mesure
            </a>

            <!-- Bouton Burger Minimaliste avec Icône SVG Claire et Visible (< 1200px) -->
            <button class="ztc-burger-btn d-xl-none" type="button" data-bs-toggle="collapse" data-bs-target="#ztcMobileDrawer" aria-controls="ztcMobileDrawer" aria-expanded="false" aria-label="Menu principal">
                <!-- 3 barres quand fermé -->
                <svg class="ztc-burger-icon-bars" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                    <line x1="4" y1="6.5" x2="20" y2="6.5"></line>
                    <line x1="4" y1="12" x2="20" y2="12"></line>
                    <line x1="4" y1="17.5" x2="20" y2="17.5"></line>
                </svg>
                <!-- Croix quand ouvert -->
                <svg class="ztc-burger-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>

    <!-- Tiroir Mobile Dépoli Apple-style (< 1200px) -->
    <div class="collapse ztc-mobile-drawer d-xl-none" id="ztcMobileDrawer">
        <div class="ztc-mobile-drawer-inner">
            <div class="ztc-mobile-drawer-header">
                <span class="ztc-mobile-section-title">Navigation & Collections</span>
            </div>

            <ul class="ztc-mobile-nav-list list-unstyled mb-0" style="list-style: none;">
                <!-- Accueil -->
                <li class="ztc-mobile-nav-item" style="list-style: none;">
                    <a class="ztc-mobile-nav-card {% if currentRoute == 'sylius_shop_homepage' %}active{% endif %}"
                       href="{{ path('sylius_shop_homepage') }}">
                        <span class="ztc-mobile-card-title">Accueil</span>
                        <svg class="ztc-mobile-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </a>
                </li>

                <!-- Univers / Taxons -->
                {% for taxonItem in taxonsToDisplay %}
                    <li class="ztc-mobile-nav-item" style="list-style: none;">
                        <a class="ztc-mobile-nav-card {% if currentSlug == taxonItem.slug %}active{% endif %}"
                           href="{{ path('sylius_shop_product_index', {'slug': taxonItem.slug}) }}">
                            <span class="ztc-mobile-card-title">{{ ztc_short_taxon_name(taxonItem) }}</span>
                            <svg class="ztc-mobile-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </a>
                    </li>
                {% endfor %}

                <!-- Journal de l'Artisan -->
                <li class="ztc-mobile-nav-item" style="list-style: none;">
                    <a class="ztc-mobile-nav-card {% if currentRoute starts with 'app_blog' %}active{% endif %}"
                       href="{{ path('app_blog_index') }}">
                        <span class="ztc-mobile-card-title">Le Journal de l'Artisan</span>
                        <svg class="ztc-mobile-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </a>
                </li>
            </ul>

            <!-- Pied du panneau mobile -->
            <div class="ztc-mobile-drawer-footer">
                <a class="ztc-btn-gold w-100 text-center py-3 d-block" href="{{ path('sylius_shop_contact_request') }}">
                    Demande Sur-Mesure
                </a>
                <p class="ztc-mobile-footer-text text-center mt-3 mb-0">Atelier ZEN TOO CRAFT • Pièces Uniques Façonnées à la Main</p>
            </div>
        </div>
    </div>
</nav>

<style id="ztc-navbar-critical-css">
/* Verrouillage immédiat des styles navbar pour éviter tout décalage de cache navigateur */
.ztc-navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: rgba(8, 10, 9, 0.88) !important;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
    padding: 1rem 0;
}

.ztc-nav-container {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
}

.ztc-burger-btn {
    background: rgba(255, 255, 255, 0.06) !important;
    border: 1px solid rgba(255, 255, 255, 0.14) !important;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #F4EFE6 !important;
    transition: all 0.25s ease;
    padding: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.ztc-burger-btn:hover {
    background: rgba(212, 175, 55, 0.15) !important;
    border-color: rgba(212, 175, 55, 0.45) !important;
    color: #D4AF37 !important;
    box-shadow: 0 4px 12px rgba(212, 175, 55, 0.25);
}

.ztc-burger-btn .ztc-burger-icon-bars {
    display: block;
}

.ztc-burger-btn .ztc-burger-icon-close {
    display: none;
}

.ztc-burger-btn[aria-expanded="true"] {
    background: rgba(212, 175, 55, 0.18) !important;
    border-color: #D4AF37 !important;
    color: #D4AF37 !important;
}

.ztc-burger-btn[aria-expanded="true"] .ztc-burger-icon-bars {
    display: none;
}

.ztc-burger-btn[aria-expanded="true"] .ztc-burger-icon-close {
    display: block;
}

/* Tiroir Mobile Apple-Style */
.ztc-mobile-drawer {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    background: rgba(8, 10, 9, 0.97) !important;
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border-bottom: 1px solid rgba(212, 175, 55, 0.25) !important;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.9);
    max-height: calc(100vh - 75px);
    overflow-y: auto;
}

.ztc-mobile-drawer-inner {
    max-width: 600px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 2.5rem;
}

.ztc-mobile-drawer-header {
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.ztc-mobile-section-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(244, 239, 230, 0.5);
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
}

.ztc-mobile-nav-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 1rem 1.25rem;
    margin-bottom: 0.65rem;
    text-decoration: none;
    transition: all 0.25s ease;
}

.ztc-mobile-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
}

.ztc-mobile-card-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 500;
    color: #F4EFE6;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
}

.ztc-mobile-card-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    color: #8E9290;
    letter-spacing: 0.01em;
}

.ztc-mobile-arrow {
    color: rgba(244, 239, 230, 0.35);
    flex-shrink: 0;
    transition: all 0.2s ease;
}

.ztc-mobile-nav-card:hover {
    background: rgba(212, 175, 55, 0.08);
    border-color: rgba(212, 175, 55, 0.35);
}

.ztc-mobile-nav-card:hover .ztc-mobile-card-title {
    color: #D4AF37;
}

.ztc-mobile-nav-card:hover .ztc-mobile-arrow {
    color: #D4AF37;
    transform: translateX(3px);
}

.ztc-mobile-nav-card.active {
    background: rgba(212, 175, 55, 0.1);
    border-color: rgba(212, 175, 55, 0.45);
}

.ztc-mobile-nav-card.active .ztc-mobile-card-title {
    color: #D4AF37;
    font-weight: 600;
}

.ztc-mobile-nav-card.active .ztc-mobile-arrow {
    color: #D4AF37;
}

.ztc-mobile-drawer-footer {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(212, 175, 55, 0.15);
}

.ztc-mobile-footer-text {
    font-size: 0.75rem;
    color: rgba(244, 239, 230, 0.45);
    letter-spacing: 0.04em;
    font-family: 'Outfit', sans-serif;
}

@media (max-width: 576px) {
    .ztc-nav-container {
        padding: 0 1rem;
    }
    .ztc-brand-logo {
        font-size: 0.92rem;
        letter-spacing: 0.14em;
    }
    .ztc-header-cta {
        padding: 0.42rem 0.85rem !important;
        font-size: 0.72rem !important;
    }
    .ztc-burger-btn {
        width: 38px;
        height: 38px;
    }
}
</style>
