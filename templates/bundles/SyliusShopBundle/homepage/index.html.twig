{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block content %}
<div class="ztc-nav-container">
    <div style="max-width: 1400px; margin: 0 auto; width: 100%;">
        
        <!-- Hero Section (Immersive) -->
        <section class="ztc-hero-immersive">
            {% set home_taxon = ztc_get_taxon_by_code('category') %}
            {% if home_taxon and home_taxon.images|length > 0 %}
                <img src="{{ home_taxon.images.first.path|imagine_filter('sylius_shop_product_original') }}" class="hero-img" alt="Homepage">
            {% else %}
                <img src="https://images.unsplash.com/photo-1599839619722-39751411ea63?q=80&w=2500&auto=format&fit=crop" class="hero-img" alt="Bambou Forest">
            {% endif %}
            
            <div class="ztc-hero-immersive-overlay"></div>
        </section>

        <!-- Bento Grid: Univers -->
        <section style="margin-top: 5rem; margin-bottom: 8rem;">
            <div style="text-align: center; margin-bottom: 3rem;">
                <h2 style="font-family: 'Outfit', sans-serif; font-size: 2.25rem; font-weight: 300;">Explorez nos Univers</h2>
            </div>
            
            <div class="ztc-bento-grid">
                {% if home_taxon and home_taxon.children|length > 0 %}
                    {% for taxon in home_taxon.children %}
                        {% set isLarge = loop.first %}
                        
                        <a href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': sylius.localeCode}) }}" class="ztc-bento-card {{ isLarge ? 'ztc-bento-large' : '' }}" style="display: block; text-decoration: none;">
                            {% if taxon.images|length > 0 %}
                                <img src="{{ taxon.images.first.path|imagine_filter('sylius_shop_product_original') }}" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.6) contrast(1.1); transition: transform 0.7s;" alt="{{ taxon.name }}" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                            {% else %}
                                <!-- Fallback image if a taxon has no image -->
                                <img src="https://images.unsplash.com/photo-1599839575945-a9e5af0c3fa5?q=80&w=800&auto=format&fit=crop" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.4) contrast(1.1); transition: transform 0.7s;" alt="{{ taxon.name }}" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                            {% endif %}
                            
                            <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(5,6,5,0.9) 0%, rgba(8,10,9,0.4) 50%, transparent 100%);"></div>
                            
                            <div style="position: absolute; bottom: 0; left: 0; padding: {{ isLarge ? '2.5rem' : '2rem' }}; width: 100%;">
                                <span class="ztc-tag-gold" style="margin-bottom: 0.5rem; display: block; font-size: 0.65rem;">Collection</span>
                                <h3 style="font-family: 'Outfit', sans-serif; font-size: {{ isLarge ? '2.25rem' : '1.5rem' }}; font-weight: 500; margin-bottom: 0.75rem; color: #fff;">{{ taxon.name }}</h3>
                                {% if taxon.description %}
                                    <p style="color: var(--text-secondary); max-width: 28rem; font-size: 0.875rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{{ taxon.description|striptags }}</p>
                                {% endif %}
                            </div>
                        </a>
                    {% endfor %}
                {% endif %}

                <!-- Bento Wide (Sur mesure - Point de contact statique) -->
                <div class="ztc-bento-card ztc-bento-wide" style="display: flex; align-items: center; padding: 2.5rem; background: linear-gradient(to bottom right, rgba(255,255,255,0.03), transparent);">
                    <div style="max-width: 32rem;">
                        <h3 style="font-family: 'Outfit', sans-serif; font-size: 1.875rem; font-weight: 500; margin-bottom: 1rem; color: #fff;">L'Art du Sur-Mesure.</h3>
                        <p style="color: var(--text-secondary); margin-bottom: 2rem; line-height: 1.6;">Chaque pièce de bambou possède sa propre résonance et courbure. Nous concevons avec vous l'instrument ou l'objet qui correspond parfaitement à votre intérieur ou votre pratique.</p>
                        <a href="{{ path('sylius_shop_contact_request') }}" style="color: var(--gold-accent); font-weight: 500; display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none;">
                            Commencer un projet
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                    </div>
                </div>

            </div>
        </section>

    </div>
</div>
{% endblock %}
