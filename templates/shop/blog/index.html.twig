{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}Le Journal de l'Artisan — ZEN TOO Craft{% endblock %}

{% block content %}
    <div class="container py-5 my-3" style="max-width: 1140px;">
        <!-- Bannière du Journal -->
        <header class="text-center mb-5 p-5" style="background: rgba(10, 12, 11, 0.95); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
            <span class="ztc-badge-nature mb-3 d-inline-block">Récits, Chroniques & Savoir-Faire</span>
            <h1 class="display-4 fw-bold mt-2" style="color: var(--text-primary, #F4EFE6); letter-spacing: 0.03em;">Le Journal de l'Artisan</h1>
            <p class="lead mt-3 mx-auto" style="color: var(--text-secondary, #A0A8A2); max-width: 750px; line-height: 1.7;">
                Explorez les secrets de la lutherie en bambou, la philosophie des matériaux naturels et la vie de notre atelier éco-responsable.
            </p>
        </header>

        <!-- Grille des Cartes d'Articles de Blog -->
        <div class="row g-4">
            {% set postsList = posts|default([]) %}
            {% if postsList is not empty %}
                {% for post in postsList %}
                    <div class="col-12 col-md-6 col-lg-4">
                        <article class="h-100 d-flex flex-column" style="background: rgba(10, 12, 11, 0.95); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: 20px; overflow: hidden; transition: transform 0.3s ease, border-color 0.3s ease;" onmouseover="this.style.transform='translateY(-5px)'; this.style.borderColor='rgba(212, 175, 55, 0.5)'" onmouseout="this.style.transform='translateY(0)'; this.style.borderColor='rgba(212, 175, 55, 0.2)'">
                            <!-- Image de Couverture -->
                            <div class="position-relative" style="height: 220px; background: #181c19; overflow: hidden;">
                                {% if post.coverImage is not empty %}
                                    <img src="{{ asset('media/image/' ~ post.coverImage) }}" alt="{{ post.title }}" class="w-100 h-100 object-fit-cover">
                                {% else %}
                                    <img src="{{ asset('media/image/flute_shakuhachi.jpeg') }}" alt="{{ post.title }}" class="w-100 h-100 object-fit-cover" style="filter: brightness(0.85);">
                                {% endif %}
                                <span class="badge position-absolute top-0 end-0 m-3 px-3 py-2" style="background: rgba(10, 12, 11, 0.85); color: #D4AF37; border: 1px solid rgba(212, 175, 55, 0.3); backdrop-filter: blur(4px);">
                                    {{ post.topic|default('Artisanat') }}
                                </span>
                            </div>

                            <!-- Corps de la Carte -->
                            <div class="p-4 d-flex flex-column flex-grow-1">
                                <div class="small mb-2" style="color: #A0A8A2;">
                                    <span>Publié le {{ post.publishedAt ? post.publishedAt|date("d/m/Y") : post.createdAt|date("d/m/Y") }}</span>
                                    <span class="mx-2">•</span>
                                    <span>Par {{ post.author|default('ZEN TOO Craft') }}</span>
                                </div>

                                <h3 class="h5 fw-bold mb-3" style="color: var(--text-primary, #F4EFE6); line-height: 1.4;">
                                    <a href="{{ path('app_blog_show', {'slug': post.slug}) }}" style="color: inherit; text-decoration: none;">
                                        {{ post.title }}
                                    </a>
                                </h3>

                                <p class="small flex-grow-1" style="color: var(--text-secondary, #A0A8A2); line-height: 1.6;">
                                    {{ post.excerpt|default(post.title)|u.truncate(120, '...') }}
                                </p>

                                <div class="mt-3 pt-3 border-top" style="border-color: rgba(212, 175, 55, 0.15) !important;">
                                    <a href="{{ path('app_blog_show', {'slug': post.slug}) }}" class="fw-bold d-inline-flex align-items-center gap-2" style="color: #D4AF37; text-decoration: none;">
                                        <span>Lire l'article</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                {% endfor %}
            {% else %}
                <div class="col-12 text-center py-5" style="background: rgba(10, 12, 11, 0.95); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: 20px;">
                    <p class="h5" style="color: var(--text-secondary, #A0A8A2);">Aucun article publié pour le moment. Revenez bientôt !</p>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
