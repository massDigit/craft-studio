{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}Le Journal de l'Artisan — ZEN TOO Craft{% endblock %}

{% block content %}
    <div class="container py-5 my-3" style="max-width: 1000px;">
        <header class="text-center mb-5">
            <span class="ztc-badge-nature mb-3 d-inline-block">📜 Récits, Chroniques & Savoir-Faire</span>
            <h1 class="display-4 fw-bold mt-2" style="color: var(--text-primary, #F4EFE6); letter-spacing: 0.03em;">Le Journal de l'Artisan</h1>
            <p class="lead mt-3 mx-auto" style="color: var(--text-secondary, #A0A8A2); max-width: 700px;">
                Découvrez les coulisses de la création, la philosophie de la lutherie en bambou et nos engagements éco-responsables.
            </p>
        </header>

        <div class="ztc-blog-collection p-4 p-md-5" style="background: rgba(10, 12, 11, 0.95); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: 24px;">
            {{ sylius_cms_render_collection('blog') }}
        </div>
    </div>
{% endblock %}
