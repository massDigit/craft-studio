{% if form is not defined %}
    {% set form = hookable_metadata.context.form|default(null) %}
{% endif %}

<!-- Quill.js Stylesheet -->
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">

<style>
    .info-tip-banner {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 4px solid #f59e0b;
        border-radius: 6px;
        padding: 0.75rem 1rem;
        margin-bottom: 1.25rem;
        color: #475569;
        font-size: 0.85rem;
    }
    .btn-ai-header-sparkle {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff !important;
        font-weight: 600;
        border: none;
        box-shadow: 0 2px 6px rgba(217, 119, 6, 0.25);
        transition: all 0.2s;
    }
    .btn-ai-header-sparkle:hover {
        background: linear-gradient(135deg, #d97706, #b45309);
        color: #fff !important;
        transform: translateY(-1px);
    }
    .modal-ai-dialog {
        max-width: 1180px;
    }
    .modal-ai-header {
        background: linear-gradient(135deg, #1e293b, #0f172a);
        color: #fff;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        padding: 1.25rem 1.75rem;
    }
    .badge-ai-model {
        background: rgba(255, 255, 255, 0.15);
        color: #fcd34d;
        font-weight: 500;
        font-size: 0.75rem;
        padding: 0.3rem 0.6rem;
        border-radius: 20px;
        border: 1px solid rgba(252, 211, 77, 0.3);
    }
    .suggestion-pill {
        display: inline-block;
        font-size: 0.75rem;
        padding: 0.25rem 0.6rem;
        background: #f1f5f9;
        color: #475569;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.15s;
        margin-right: 0.4rem;
        margin-bottom: 0.4rem;
        border: 1px solid #e2e8f0;
    }
    .suggestion-pill:hover {
        background: #fdf8eb;
        color: #c59b27;
        border-color: #c59b27;
    }
    .preview-content-box {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 1.25rem;
        height: 380px;
        overflow-y: auto;
        font-size: 0.93rem;
        line-height: 1.6;
        color: #334155;
    }
    .preview-content-box h2 {
        font-size: 1.15rem;
        font-weight: 700;
        color: #1e293b;
        margin-top: 1.1rem;
        margin-bottom: 0.4rem;
        border-left: 3px solid #c59b27;
        padding-left: 0.75rem;
    }
    .preview-content-box p {
        margin-bottom: 0.85rem;
    }
    .preview-content-box blockquote {
        border-left: 3px solid #cbd5e1;
        padding-left: 1rem;
        color: #64748b;
        font-style: italic;
        margin: 1rem 0;
    }
    .adjustment-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 0.85rem;
        margin-top: 0.85rem;
    }
    .refine-pill-btn {
        font-size: 0.75rem;
        padding: 0.2rem 0.55rem;
        border-radius: 16px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #475569;
        cursor: pointer;
        transition: all 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }
    .refine-pill-btn:hover {
        background: #f1f5f9;
        border-color: #94a3b8;
        color: #1e293b;
    }
</style>

<div class="row">
    <!-- COLONNE GAUCHE (8 COLS) : CONTENU & TEXTE RICHE -->
    <div class="col-12 col-lg-8">
        
        <!-- BANDEAU D'INFORMATION SOBRE (Sans bouton ni grosse icône) -->
        <div class="info-tip-banner">
            <strong>Astuce :</strong> Le bouton <em>« Rédiger avec l'Assistant IA »</em> en haut de page vous permet de composer automatiquement le récit d'atelier, son extrait et de générer le slug URL.
        </div>

        <div class="card mb-4 shadow-sm border">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="ti ti-file-text text-primary me-2"></i>Publication & Contenu de l'Article</span>
                <span class="badge bg-light text-secondary border">Journal de l'Artisan</span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    {{ form_row(form.title, {'attr': {'id': 'app_blog_post_title'}}) }}
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.topic, {'attr': {'id': 'app_blog_post_topic'}}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.code, {'attr': {'id': 'app_blog_post_code'}}) }}
                    </div>
                </div>
                <div class="mb-3">
                    {{ form_row(form.slug, {'attr': {'id': 'app_blog_post_slug'}}) }}
                </div>
                <div class="mb-3">
                    {{ form_row(form.excerpt, {'attr': {'id': 'app_blog_post_excerpt'}}) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.content, {'attr': {'id': 'app_blog_post_content'}}) }}
                </div>
            </div>
        </div>
    </div>

    <!-- COLONNE DROITE (4 COLS) : IMAGE & STATUT -->
    <div class="col-12 col-lg-4">
        <div class="card mb-4 shadow-sm border">
            <div class="card-header bg-white fw-bold">
                <i class="ti ti-photo me-2 text-secondary"></i>Image de Couverture
            </div>
            <div class="card-body">
                <div class="mb-3">
                    {{ form_row(form.coverImageFile) }}
                    {% if form.vars.data.coverImage is defined and form.vars.data.coverImage is not empty %}
                        <div class="mt-3 p-2 bg-light rounded border text-center">
                            <label class="form-label small text-muted d-block mb-2">Image actuelle :</label>
                            <img src="{{ asset('media/image/' ~ form.vars.data.coverImage) }}" alt="Couverture actuelle" class="img-fluid rounded" style="max-height: 180px; object-fit: cover;">
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="card shadow-sm border">
            <div class="card-header bg-white fw-bold">
                <i class="ti ti-toggle-right me-2 text-success"></i>Statut de Publication
            </div>
            <div class="card-body">
                <div class="mb-3">
                    {{ form_row(form.published, {'attr': {'id': 'app_blog_post_published'}}) }}
                </div>
                <div class="text-muted small">
                    <i class="ti ti-calendar me-1"></i> Date : <strong>{{ "now"|date("d/m/Y") }}</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- MODAL ATELIER DE RÉDACTION IA (DIALOGUE & AJUSTEMENTS CLAIRS)  -->
<!-- ============================================================== -->
<div class="modal fade" id="aiBlogModal" tabindex="-1" aria-labelledby="aiBlogModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-ai-dialog">
        <div class="modal-content shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
            
            <!-- En-tête du Modal -->
            <div class="modal-ai-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-2 rounded bg-warning bg-opacity-25 text-warning">
                        <i class="ti ti-sparkles fs-4"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="aiBlogModalLabel">Atelier IA • Journal de l'Artisan</h5>
                        <span class="text-white-50 small">Définissez vos directives : l'IA génère le titre, le résumé, le slug et le récit formaté.</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-ai-model"><i class="ti ti-cpu me-1"></i> Qwen 2.5 Local</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <!-- Corps du Modal : 2 Volets Clairs -->
            <div class="modal-body p-4 bg-light">
                <div class="row g-4">
                    
                    <!-- VOLET GAUCHE : DIRECTIVES PERSONNALISABLES -->
                    <div class="col-lg-5">
                        <div class="card border-0 shadow-sm h-100 mb-0">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                    <h6 class="fw-bold text-dark mb-0"><i class="ti ti-adjustments-horizontal text-primary me-1"></i> Directives Initiales</h6>
                                    <span class="badge bg-light text-muted border">Étape 1 : Cadrage</span>
                                </div>

                                <!-- 1. Sujet / Idée -->
                                <div class="mb-3">
                                    <label class="form-label small fw-bold mb-1">Sujet ou Thème de l'article <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm" id="ai-topic" placeholder="Ex: Le travail du bambou noble et le son du Shakuhachi...">
                                    
                                    <div class="mt-2">
                                        <span class="text-muted d-block mb-1" style="font-size: 0.7rem; font-weight: 600; text-transform: uppercase;">Suggestions d'idées :</span>
                                        <span class="suggestion-pill" onclick="window._ztcApplySuggestion('Secrets d\'Atelier : Le façonnage d\'une flûte Shakuhachi traditionnelle', 'Coulisses de fabrication et respect des traditions', 'Savoir-Faire', 'Passionné et authentique')">Coulisses d'Atelier</span>
                                        <span class="suggestion-pill" onclick="window._ztcApplySuggestion('Guide d\'Entretien : Préserver et huiler son instrument en bambou', 'Guide pratique pas-à-pas avec astuces d\'atelier', 'Conseils d\'Entretien', 'Pédagogique et bienveillant')">Guide Entretien</span>
                                        <span class="suggestion-pill" onclick="window._ztcApplySuggestion('Pourquoi choisir le bambou traité thermiquement pour un luminaire', 'Focus matière et caractéristiques esthétiques', 'Secrets du Bois', 'Élégant et sobre')">Focus Matière</span>
                                    </div>
                                </div>

                                <!-- 2. Angle Narratif : Prédéfini OU Saisi librement -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label small fw-bold mb-0">Angle narratif</label>
                                        <span class="text-muted" style="font-size: 0.72rem;">Prédéfini ou libre</span>
                                    </div>
                                    <div class="input-group input-group-sm">
                                        <select class="form-select form-select-sm" id="ai-angle-select" onchange="window._ztcHandleAngleSelect(this.value)" style="max-width: 140px;">
                                            <option value="storytelling" selected>📖 Récit atelier</option>
                                            <option value="guide">🛠️ Guide pratique</option>
                                            <option value="expertise">🔬 Dossier matière</option>
                                            <option value="custom">✏️ Personnalisé...</option>
                                        </select>
                                        <input type="text" class="form-control form-control-sm" id="ai-angle-custom" value="Récit intime d'atelier et dialogue avec le fil de la matière" placeholder="Ou décrivez votre propre angle...">
                                    </div>
                                </div>

                                <!-- 3. Tonalité : Prédéfinie OU Saisie librement -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label small fw-bold mb-0">Tonalité de rédaction</label>
                                        <span class="text-muted" style="font-size: 0.72rem;">Prédéfinie ou libre</span>
                                    </div>
                                    <div class="input-group input-group-sm">
                                        <select class="form-select form-select-sm" id="ai-tone-select" onchange="window._ztcHandleToneSelect(this.value)" style="max-width: 140px;">
                                            <option value="noble" selected>Noble & Poétique</option>
                                            <option value="warm">Chaleureux</option>
                                            <option value="zen">Épuré / Zen</option>
                                            <option value="expert">Technique</option>
                                            <option value="custom">✏️ Personnalisée...</option>
                                        </select>
                                        <input type="text" class="form-control form-control-sm" id="ai-tone-custom" value="Noble, contemplatif et respectueux du végétal" placeholder="Ou décrivez votre propre ton...">
                                    </div>
                                </div>

                                <!-- 4. Points clés réels (Matières, Finition) -->
                                <div class="mb-3">
                                    <label class="form-label small fw-bold mb-1">
                                        Faits réels & Matières d'atelier à inclure
                                        <i class="ti ti-info-circle text-muted" title="Vos détails techniques réels évitent tout contenu générique."></i>
                                    </label>
                                    <textarea class="form-control form-control-sm" id="ai-keypoints" rows="3" placeholder="Ex: Bambou naturel sélectionné, traitement thermique doux, huile végétale protectrice..."></textarea>
                                </div>

                                <!-- 5. Rubrique & Longueur -->
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="form-label small fw-bold mb-1">Rubrique Journal</label>
                                        <input type="text" class="form-control form-control-sm" id="ai-target-topic" value="Savoir-Faire">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-bold mb-1">Longueur visée</label>
                                        <select class="form-select form-select-sm" id="ai-length">
                                            <option value="short">Court (~400 mots)</option>
                                            <option value="medium" selected>Standard (~700 mots)</option>
                                            <option value="long">Dossier (~1100 mots)</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Bouton Génération Initiale -->
                                <button type="button" class="btn btn-warning w-100 fw-bold py-2 shadow-sm text-dark" id="btn-generate-ai" onclick="window._ztcGenerateBlogPost()">
                                    <i class="ti ti-sparkles me-1"></i> Générer le premier brouillon
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- VOLET DROIT : APERÇU EN DIRECT & SYSTÈME D'AJUSTEMENT CLAIR -->
                    <div class="col-lg-7">
                        <div class="card border-0 shadow-sm h-100 mb-0 d-flex flex-column">
                            <div class="card-header bg-white border-bottom p-2 d-flex justify-content-between align-items-center">
                                <span class="fw-bold small text-dark"><i class="ti ti-eye text-primary me-1"></i> Brouillon Actuel en Prévisualisation</span>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-light text-secondary border small" id="meta-words">0 mot</span>
                                    <span class="badge bg-light text-secondary border small" id="meta-reading">0 min de lecture</span>
                                </div>
                            </div>

                            <div class="card-body p-3 flex-grow-1 d-flex flex-column">
                                <!-- Boîte de prévisualisation WYSIWYG -->
                                <div class="preview-content-box" id="ai-preview-box">
                                    <!-- Aperçu de l'Extrait / Chapeau -->
                                    <div class="p-2 mb-3 rounded" style="background-color: #fdf8eb; border-left: 4px solid #c59b27;">
                                        <span class="fw-bold d-block text-uppercase small text-muted" style="letter-spacing: 0.05em; font-size: 0.72rem;">Extrait (alimentera le champ Excerpt) :</span>
                                        <p class="mb-0 fst-italic text-dark small" id="preview-teaser">
                                            Renseignez vos directives à gauche et cliquez sur « Générer le premier brouillon » pour afficher ici votre récit d'atelier.
                                        </p>
                                    </div>

                                    <!-- Corps du texte -->
                                    <div id="preview-body">
                                        <p class="text-muted fst-italic text-center my-4">Le corps complet de l'article avec intertitres apparaîtra ici.</p>
                                    </div>
                                </div>

                                <!-- SECTION D'AJUSTEMENT CLAIRE ET EXPLICITE -->
                                <div class="adjustment-box">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small fw-bold text-dark"><i class="ti ti-message-chatbot text-primary me-1"></i> Demander un ajustement précis à l'IA sur ce texte :</span>
                                        <button type="button" class="btn btn-sm btn-link text-muted p-0 text-decoration-none small" onclick="window._ztcRegenerateCompletely()" title="Recommencer de zéro">
                                            <i class="ti ti-refresh me-1"></i> Régénérer une autre version complète
                                        </button>
                                    </div>

                                    <!-- Barre d'ajustement : consigne libre + bouton Appliquer immédiat -->
                                    <div class="input-group input-group-sm mb-2">
                                        <input type="text" class="form-control" id="ai-refine-prompt" placeholder="Ex: Peux-tu insérer un conseil d'entretien au chiffon doux et rendre la conclusion plus chaleureuse ?">
                                        <button class="btn btn-primary fw-semibold" type="button" id="btn-apply-refine" onclick="window._ztcSubmitCustomRefinement()">
                                            <i class="ti ti-send me-1"></i> Appliquer la retouche
                                        </button>
                                    </div>

                                    <!-- Raccourcis de consignes rapides en 1 clic -->
                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                        <span class="text-muted" style="font-size: 0.72rem;">Retouches directes en 1 clic :</span>
                                        <button type="button" class="refine-pill-btn" onclick="window._ztcApplyQuickRefine('humanize')"><i class="ti ti-sparkles text-info"></i> Humaniser & Épurer</button>
                                        <button type="button" class="refine-pill-btn" onclick="window._ztcApplyQuickRefine('poetic')"><i class="ti ti-feather text-warning"></i> Plus poétique</button>
                                        <button type="button" class="refine-pill-btn" onclick="window._ztcApplyQuickRefine('technical')"><i class="ti ti-tools text-primary"></i> Plus technique</button>
                                        <button type="button" class="refine-pill-btn" onclick="window._ztcApplyQuickRefine('shorten')"><i class="ti ti-cut text-danger"></i> Raccourcir</button>
                                        <button type="button" class="refine-pill-btn" onclick="window._ztcApplyQuickRefine('advice')"><i class="ti ti-bulb text-success"></i> Ajouter une astuce pro</button>
                                    </div>
                                </div>
                            </div>

                            <!-- Pied du Modal : Action d'injection finale -->
                            <div class="modal-footer bg-white border-top p-3 d-flex justify-content-between">
                                <div class="text-muted small">
                                    <i class="ti ti-info-circle text-primary me-1"></i> Insère : <strong>Titre</strong>, <strong>Rubrique</strong>, <strong>Slug</strong>, <strong>Extrait</strong> et <strong>Corps d'article</strong>.
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Annuler</button>
                                    <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" onclick="window._ztcInjectIntoBlogPostForm()">
                                        <i class="ti ti-file-import me-1"></i> Insérer dans l'article du Journal
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- Logique Complète de l'Assistant IA Journal -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // 1. Injection dynamique du bouton "Rédiger avec l'Assistant IA" dans la barre d'action supérieure
        var btnList = document.querySelector('.page-header .btn-list, .btn-list');
        if (btnList && !btnList.querySelector('#btn-trigger-ai-modal')) {
            var aiBtn = document.createElement('button');
            aiBtn.type = 'button';
            aiBtn.id = 'btn-trigger-ai-modal';
            aiBtn.className = 'btn btn-ai-header-sparkle btn-sm px-3 shadow-sm';
            aiBtn.innerHTML = '<i class="ti ti-sparkles me-1"></i> Rédiger avec l\'Assistant IA';
            aiBtn.setAttribute('data-bs-toggle', 'modal');
            aiBtn.setAttribute('data-bs-target', '#aiBlogModal');

            var submitBtn = btnList.querySelector('button[type="submit"]');
            if (submitBtn) {
                btnList.insertBefore(aiBtn, submitBtn);
            } else {
                btnList.appendChild(aiBtn);
            }
        }

        // Toast de notification Tabler
        window._ztcShowToast = function(message, type) {
            type = type || 'success';
            var container = document.getElementById('ztc-toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'ztc-toast-container';
                container.style.position = 'fixed';
                container.style.top = '1.5rem';
                container.style.right = '1.5rem';
                container.style.zIndex = '999999';
                container.style.display = 'flex';
                container.style.flexDirection = 'column';
                container.style.gap = '0.5rem';
                container.style.pointerEvents = 'none';
                document.body.appendChild(container);
            }

            var toast = document.createElement('div');
            toast.className = 'alert alert-' + (type === 'success' ? 'success' : 'danger') + ' alert-dismissible shadow fade show mb-0';
            toast.style.pointerEvents = 'auto';
            toast.style.minWidth = '320px';
            toast.style.maxWidth = '440px';
            toast.style.borderRadius = '8px';
            toast.style.border = type === 'success' ? '1px solid #2fb344' : '1px solid #d63939';
            toast.style.backgroundColor = type === 'success' ? '#edfbf0' : '#fdeded';
            toast.style.color = '#1e293b';
            toast.innerHTML = '<div class="d-flex align-items-center">' +
                '<span class="fs-3 me-2">' + (type === 'success' ? '✨' : '⚠️') + '</span>' +
                '<div>' +
                    '<strong class="d-block text-' + (type === 'success' ? 'success' : 'danger') + '">' + (type === 'success' ? 'IA ZEN TOO' : 'Erreur IA') + '</strong>' +
                    '<div class="small text-muted">' + message + '</div>' +
                '</div>' +
                '<button type="button" class="btn-close ms-auto" aria-label="Close"></button>' +
            '</div>';

            toast.querySelector('.btn-close').addEventListener('click', function() {
                toast.remove();
            });

            container.appendChild(toast);

            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-10px)';
                toast.style.transition = 'all 0.4s ease-out';
                setTimeout(function() { toast.remove(); }, 400);
            }, 4000);
        };

        // Données d'état du modal
        var currentArticleData = {
            title: '',
            topic: '',
            slug: '',
            code: '',
            excerpt: '',
            content: ''
        };

        window._ztcHandleAngleSelect = function(val) {
            var customInput = document.getElementById('ai-angle-custom');
            if (!customInput) return;
            if (val === 'storytelling') customInput.value = "Récit intime d'atelier et dialogue avec le fil de la matière";
            if (val === 'guide') customInput.value = "Guide pratique pas-à-pas avec astuces concrètes d'atelier";
            if (val === 'expertise') customInput.value = "Dossier matière approfondi sur les propriétés acoustiques et mécaniques";
            if (val === 'custom') {
                customInput.value = "";
                customInput.focus();
            }
        };

        window._ztcHandleToneSelect = function(val) {
            var customInput = document.getElementById('ai-tone-custom');
            if (!customInput) return;
            if (val === 'noble') customInput.value = "Noble, contemplatif et respectueux du végétal";
            if (val === 'warm') customInput.value = "Chaleureux, pédagogue et proche du lecteur";
            if (val === 'zen') customInput.value = "Épuré, sobre et minimaliste";
            if (val === 'expert') customInput.value = "Technique, précis et documenté";
            if (val === 'custom') {
                customInput.value = "";
                customInput.focus();
            }
        };

        window._ztcApplySuggestion = function(topic, angleText, targetTopic, toneText) {
            var topicEl = document.getElementById('ai-topic');
            var angleEl = document.getElementById('ai-angle-custom');
            var topicTargetEl = document.getElementById('ai-target-topic');
            var toneEl = document.getElementById('ai-tone-custom');

            if (topicEl) topicEl.value = topic;
            if (angleEl) angleEl.value = angleText;
            if (topicTargetEl) topicTargetEl.value = targetTopic;
            if (toneEl) toneEl.value = toneText;
            window._ztcGenerateBlogPost();
        };

        function updateWordCount(text) {
            var words = text.trim() ? text.trim().split(/\s+/).length : 0;
            var minutes = Math.max(1, Math.round(words / 200));
            var wordsBadge = document.getElementById('meta-words');
            var readingBadge = document.getElementById('meta-reading');
            if (wordsBadge) wordsBadge.textContent = '~' + words + ' mots';
            if (readingBadge) readingBadge.textContent = minutes + ' min de lecture';
        }

        // Génération du premier brouillon
        window._ztcGenerateBlogPost = async function() {
            var topic = (document.getElementById('ai-topic') || {}).value || '';
            var angle = (document.getElementById('ai-angle-custom') || {}).value || '';
            var tone = (document.getElementById('ai-tone-custom') || {}).value || '';
            var keypoints = (document.getElementById('ai-keypoints') || {}).value || '';
            var targetTopic = (document.getElementById('ai-target-topic') || {}).value || '';
            var length = (document.getElementById('ai-length') || {}).value || 'medium';

            if (!topic.trim()) {
                alert('Veuillez renseigner le sujet ou thème de l\'article.');
                return;
            }

            var btn = document.getElementById('btn-generate-ai');
            var previewBox = document.getElementById('ai-preview-box');
            var originalHtml = btn ? btn.innerHTML : '';

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> L\'IA compose votre premier brouillon...';
            }
            if (previewBox) previewBox.style.opacity = '0.35';

            try {
                var response = await fetch('/admin/ajax/ai/generate-blog-post', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        topic: topic,
                        angle: angle,
                        tone: tone,
                        keypoints: keypoints,
                        targetTopic: targetTopic,
                        length: length
                    })
                });

                var resData = await response.json();
                if (resData.success && resData.data) {
                    currentArticleData = resData.data;

                    var previewTeaser = document.getElementById('preview-teaser');
                    var previewBody = document.getElementById('preview-body');

                    if (previewTeaser) previewTeaser.innerHTML = currentArticleData.excerpt;
                    if (previewBody) previewBody.innerHTML = currentArticleData.content;

                    updateWordCount((currentArticleData.excerpt || '') + ' ' + (currentArticleData.content || '').replace(/<[^>]+>/g, ' '));
                    window._ztcShowToast('Premier brouillon composé avec succès !', 'success');
                } else {
                    window._ztcShowToast('Erreur IA : ' + (resData.error || 'Erreur inconnue'), 'danger');
                }
            } catch (err) {
                console.error(err);
                window._ztcShowToast('Erreur de communication avec le service IA.', 'danger');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
                if (previewBox) previewBox.style.opacity = '1';
            }
        };

        // Régénérer de zéro
        window._ztcRegenerateCompletely = function() {
            window._ztcGenerateBlogPost();
        };

        // Appliquer une retouche personnalisée
        window._ztcSubmitCustomRefinement = function() {
            var promptInput = document.getElementById('ai-refine-prompt');
            var instruction = promptInput ? promptInput.value.trim() : '';
            if (!instruction) {
                alert('Veuillez préciser la consigne de retouche que vous souhaitez transmettre à l\'IA.');
                return;
            }
            executeRefinement(instruction);
            if (promptInput) promptInput.value = '';
        };

        // Appliquer une retouche rapide en 1 clic
        window._ztcApplyQuickRefine = function(type) {
            var instruction = '';
            if (type === 'humanize') instruction = "Humanise complètement le texte : élimine tout ton commercial ou promotionnel, retire les tirets cadratins (« — »), et rétablis un phrasé fluide et naturel d'artisan en atelier.";
            if (type === 'poetic') instruction = "Renforce la poésie et la sensibilité artisanale de la plume, avec des métaphores nobles sur la matière.";
            if (type === 'technical') instruction = "Insère des données techniques concrètes sur les tolérances de façonnage, le séchage et la lutherie.";
            if (type === 'shorten') instruction = "Condense et synthétise le texte pour le rendre plus percutant, autour de 400 mots.";
            if (type === 'advice') instruction = "Ajoute un encadré ou un conseil pratique de maître artisan pour préserver l'objet au fil du temps.";
            executeRefinement(instruction);
        };

        // Exécution de l'ajustement
        async function executeRefinement(instruction) {
            if (!currentArticleData.content || !currentArticleData.content.trim()) {
                alert('Veuillez d\'abord générer un premier brouillon avant de demander un ajustement.');
                return;
            }

            var applyBtn = document.getElementById('btn-apply-refine');
            var previewBox = document.getElementById('ai-preview-box');
            var originalBtnHtml = applyBtn ? applyBtn.innerHTML : '';

            if (applyBtn) {
                applyBtn.disabled = true;
                applyBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Ajustement...';
            }
            if (previewBox) previewBox.style.opacity = '0.35';

            try {
                var response = await fetch('/admin/ajax/ai/refine-blog-post', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        content: currentArticleData.content,
                        excerpt: currentArticleData.excerpt,
                        instruction: instruction
                    })
                });

                var resData = await response.json();
                if (resData.success && resData.data) {
                    currentArticleData.content = resData.data.content;
                    if (resData.data.excerpt) {
                        currentArticleData.excerpt = resData.data.excerpt;
                    }

                    var previewTeaser = document.getElementById('preview-teaser');
                    var previewBody = document.getElementById('preview-body');

                    if (previewTeaser) previewTeaser.innerHTML = currentArticleData.excerpt;
                    if (previewBody) previewBody.innerHTML = currentArticleData.content;

                    updateWordCount((currentArticleData.excerpt || '') + ' ' + (currentArticleData.content || '').replace(/<[^>]+>/g, ' '));
                    window._ztcShowToast('Retouche appliquée avec succès !', 'success');
                } else {
                    window._ztcShowToast('Erreur lors de la retouche : ' + (resData.error || 'Erreur inconnue'), 'danger');
                }
            } catch (err) {
                console.error(err);
                window._ztcShowToast('Erreur de communication avec le service IA.', 'danger');
            } finally {
                if (applyBtn) {
                    applyBtn.disabled = false;
                    applyBtn.innerHTML = originalBtnHtml;
                }
                if (previewBox) previewBox.style.opacity = '1';
            }
        }

        // Injection dans le formulaire Sylius
        window._ztcInjectIntoBlogPostForm = function() {
            if (!currentArticleData.title && !currentArticleData.content) {
                alert('Veuillez d\'abord générer un article avant de l\'insérer.');
                return;
            }

            var titleInput = document.getElementById('app_blog_post_title') || document.querySelector('input[name*="[title]"]');
            var topicInput = document.getElementById('app_blog_post_topic') || document.querySelector('input[name*="[topic]"]');
            var slugInput = document.getElementById('app_blog_post_slug') || document.querySelector('input[name*="[slug]"]');
            var codeInput = document.getElementById('app_blog_post_code') || document.querySelector('input[name*="[code]"]');
            var excerptInput = document.getElementById('app_blog_post_excerpt') || document.querySelector('textarea[name*="[excerpt]"]');

            if (titleInput && currentArticleData.title) titleInput.value = currentArticleData.title;
            if (topicInput && currentArticleData.topic) topicInput.value = currentArticleData.topic;
            if (slugInput && currentArticleData.slug) slugInput.value = currentArticleData.slug;
            if (codeInput) {
                var generatedCode = 'post-' + (currentArticleData.slug || 'artisan').substring(0, 30);
                if (!codeInput.value || codeInput.value.trim() === '') {
                    codeInput.value = generatedCode;
                }
            }
            if (excerptInput && currentArticleData.excerpt) excerptInput.value = currentArticleData.excerpt;

            // Injection dans le WYSIWYG Quill et le textarea sous-jacent
            var contentTextarea = document.getElementById('app_blog_post_content') || document.querySelector('textarea[name*="[content]"]');
            var qlEditor = document.querySelector('.ql-editor');
            if (currentArticleData.content) {
                if (contentTextarea) {
                    contentTextarea.value = currentArticleData.content;
                    if (contentTextarea.__quill && contentTextarea.__quill.clipboard) {
                        contentTextarea.__quill.clipboard.dangerouslyPasteHTML(currentArticleData.content);
                    } else if (qlEditor) {
                        qlEditor.innerHTML = currentArticleData.content;
                    }
                    contentTextarea.dispatchEvent(new Event('input', { bubbles: true }));
                    contentTextarea.dispatchEvent(new Event('change', { bubbles: true }));
                } else if (qlEditor) {
                    qlEditor.innerHTML = currentArticleData.content;
                }
            }

            // Fermer le modal Bootstrap
            var modalEl = document.getElementById('aiBlogModal');
            if (modalEl) {
                var modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modalInstance.hide();
            }

            window._ztcShowToast('Article inséré avec succès dans le Journal de l\'Artisan !', 'success');
        };
    });
</script>
